{
    "logName": "postfixlogs",
    "indexField": {
        "name": "MessageID",
        "captureRegex": "[0-9,A-F]{11}",
        "sqlType": "char(11)",
        "regexMatchGroup": 0,
        "displayInShortOutput": false
    },
    "logFields": [
        {
            "name": "Subject",
            "captureRegex": "(?<=Subject: ).+(?= from.+\\[.+\\])",
            "sqlType": "varchar(255)",
            "regexMatchGroup": 0,
            "displayInShortOutput": true
        },
        {
            "name": "Sender",
            "captureRegex": "(?<=[0-9,A-F]{11}: from=<)[^>]+",
            "sqlType": "varchar(255)",
            "regexMatchGroup": 0,
            "displayInShortOutput": true
        },
        {
            "name": "Recipient",
            "captureRegex": "(?<=[0-9,A-F]{11}: to=<)[^>]+",
            "sqlType": "varchar(255)",
            "regexMatchGroup": 0,
            "displayInShortOutput": true
        },
        {
            "name": "Status",
            "captureRegex": "(?<=status=)[^ ]+",
            "sqlType": "varchar(20)",
            "regexMatchGroup": 0,
            "displayInShortOutput": true
        },
        {
            "name": "Protocol",
            "captureRegex": "(?<=proto=)[^ ]+",
            "sqlType": "varchar(20)",
            "regexMatchGroup": 0,
            "displayInShortOutput": false
        },
        {
            "name": "DateTime",
            "captureRegex": "^[^ ]+",
            "sqlType": "datetime",
            "regexMatchGroup": 0,
            "displayInShortOutput": true
        },
        {
            "name": "MailServer",
            "captureRegex": "(?<=^.{32}\\s)[^ ]+",
            "sqlType": "varchar(255)",
            "regexMatchGroup": 0,
            "displayInShortOutput": false
        },
        {
            "name": "ClientName",
            "captureRegex": "(?<=client=)([^[]+)\\[([^]]+)",
            "sqlType": "varchar(255)",
            "regexMatchGroup": 1,
            "displayInShortOutput": false
        },
        {
            "name": "ClientIP",
            "captureRegex": "(?<=client=)([^[]+)\\[([^]]+)",
            "sqlType": "varchar(255)",
            "regexMatchGroup": 2,
            "displayInShortOutput": false
        }
    ]
}